{
  "manifest_version": 2,
  "name": "Twitch Drop Auto-Claimer",
  "version": "0.6.21",
  "description": "Auto-claim Twitch Drops while you keep a stream/inventory tab open. Also reloads the inventory tab periodically.",
  "permissions": [
    "alarms",
    "tabs",
    "storage",
    "downloads",
    "sessions",
    "*://*.twitch.tv/*",
    "https://35-188-24-245.sslip.io/*"
  ],
  "background": {
    "scripts": [
      "i18n.js",
      "shared.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Twitch Drop Auto-Claimer"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.twitch.tv/*"
      ],
      "js": [
        "gql-bridge.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://www.twitch.tv/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://www.twitch.tv/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "twitch-drop-auto-claimer@foolshang",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
